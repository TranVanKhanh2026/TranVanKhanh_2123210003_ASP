@{
    Layout = "_LayoutAdmin";
}

@model IEnumerable<CMS.Data.Entities.Product>

<h2 style="margin-bottom:20px;">
    QUẢN LÝ SẢN PHẨM
</h2>

<p>
    <a asp-action="Create"
       style="background:#198754;color:white;padding:10px 15px;text-decoration:none;border-radius:5px;">
        Thêm sản phẩm
    </a>
</p>

<table style="width:100%; border-collapse:collapse;">

    <thead style="background:#198754; color:white;">
        <tr>
            <th style="padding:10px; border:1px solid #ddd;">ID</th>
            <th style="padding:10px; border:1px solid #ddd;">Ảnh</th>
            <th style="padding:10px; border:1px solid #ddd;">Tên Sản Phẩm</th>
            <th style="padding:10px; border:1px solid #ddd;">Danh Mục</th>
            <th style="padding:10px; border:1px solid #ddd;">Giá</th>
            <th style="padding:10px; border:1px solid #ddd;">Số Lượng</th>
            <th style="padding:10px; border:1px solid #ddd;">Chức Năng</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td style="padding:10px; border:1px solid #ddd;">
                    @item.Id
                </td>

                <td style="padding:10px; border:1px solid #ddd;">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl"
                             width="80"
                             height="80"
                             style="object-fit:cover;" />
                    }
                </td>

                <td style="padding:10px; border:1px solid #ddd;">
                    @item.Name
                </td>

                <td style="padding:10px; border:1px solid #ddd;">
                    @(item.CategoryProduct?.Name)
                </td>

                <td style="padding:10px; border:1px solid #ddd;">
                    @item.Price
                </td>

                <td style="padding:10px; border:1px solid #ddd;">
                    @item.StockQuantity
                </td>

                <td style="padding:10px; border:1px solid #ddd;">

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       style="background:#0d6efd;color:white;padding:6px 10px;text-decoration:none;border-radius:4px;">
                        Sửa
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?')"
                       style="background:#dc3545;color:white;padding:6px 10px;text-decoration:none;border-radius:4px;">
                        Xóa
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>

