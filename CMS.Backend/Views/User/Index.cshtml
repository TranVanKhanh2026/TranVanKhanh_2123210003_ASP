@model IEnumerable<CMS.Data.Entities.User>
@{
    Layout = "_LayoutAdmin";
}
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2 style="font-weight:bold; color:#222;">QUẢN LÝ THÀNH VIÊN</h2>

    <!-- Nút Thêm mới dùng asp-action -->
    <a asp-action="Create" class="btn btn-success" style="background:#28a745; color:white; padding:8px 14px; text-decoration:none; border-radius:4px;">
        + Thêm thành viên mới
    </a>
</div>

<table style="width:100%; border-collapse:collapse; background:white;">
    <thead style="background:#f1f1f1;">
        <tr>
            <th style="padding:10px; border:1px solid #ddd;">ID</th>
            <th style="padding:10px; border:1px solid #ddd;">Tên Đăng Nhập</th>
            <th style="padding:10px; border:1px solid #ddd;">Họ Và Tên</th>
            <th style="padding:10px; border:1px solid #ddd;">Quyền Hạn</th>
            <th style="padding:10px; border:1px solid #ddd;">Thao Tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="padding:10px; border:1px solid #ddd;">@item.Id</td>
                <td style="padding:10px; border:1px solid #ddd; font-weight:bold;">@item.Username</td>
                <td style="padding:10px; border:1px solid #ddd;">@item.FullName</td>
                <td style="padding:10px; border:1px solid #ddd;">
                    @if (item.Role == "Admin")
                    {
                        <span style="background:#dc3545; color:white; padding:4px 8px; border-radius:4px;">Administrator</span>
                    }
                    else if (item.Role == "Editor")
                    {
                        <span style="background:#17a2b8; color:white; padding:4px 8px; border-radius:4px;">Editor</span>
                    }
                    else
                    {
                        <span style="background:#6c757d; color:white; padding:4px 8px; border-radius:4px;">@item.Role</span>
                    }
                </td>
                <td style="padding:10px; border:1px solid #ddd;">
                    <!-- Nút Sửa dùng asp-action -->
                    <a asp-action="Edit" asp-route-id="@item.Id"
                       class="btn btn-outline-warning"
                       style="background:#ffc107; color:black; padding:5px 10px; text-decoration:none; border-radius:4px; margin-right:5px;">
                        Sửa
                    </a>
                    <!-- Nút Xóa có confirm -->
                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-outline-danger"
                       style="background:#dc3545; color:white; padding:5px 10px; text-decoration:none; border-radius:4px;"
                       onclick="return confirm('Bạn có chắc chắn muốn xóa thành viên @item.Username không?');">
                        Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>