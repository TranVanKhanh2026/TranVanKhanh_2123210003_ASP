@model IEnumerable<CMS.Data.Entities.User>

<!-- Tiêu đề và nút thêm -->
<div style="
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
">

    <h2 style="
        font-weight:bold;
        color:#222;
    ">
        QUẢN LÝ THÀNH VIÊN
    </h2>

    <!-- Nút thêm thành viên -->
    <a href="#"
       style="
            background:#28a745;
            color:white;
            padding:8px 14px;
            text-decoration:none;
            border-radius:4px;
            font-size:14px;
       ">
        + Thêm thành viên mới
    </a>

</div>

<!-- Bảng danh sách -->
<table style="
    width:100%;
    border-collapse:collapse;
    background:white;
">

    <!-- Header -->
    <thead style="
        background:#f1f1f1;
    ">

        <tr>

            <th style="padding:10px; border:1px solid #ddd;">
                ID
            </th>

            <th style="padding:10px; border:1px solid #ddd;">
                Tên Đăng Nhập
            </th>

            <th style="padding:10px; border:1px solid #ddd;">
                Họ Và Tên
            </th>

            <th style="padding:10px; border:1px solid #ddd;">
                Quyền Hạn
            </th>

            <th style="padding:10px; border:1px solid #ddd;">
                Thao Tác
            </th>

        </tr>

    </thead>

    <!-- Body -->
    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <!-- ID -->
                <td style="padding:10px; border:1px solid #ddd;">
                    @item.Id
                </td>

                <!-- Username -->
                <td style="
                    padding:10px;
                    border:1px solid #ddd;
                    font-weight:bold;
                    ">
                    @item.Username
                </td>

                <!-- Họ tên -->
                <td style="padding:10px; border:1px solid #ddd;">
                    @item.FullName
                </td>

                <!-- Quyền -->
                <td style="padding:10px; border:1px solid #ddd;">

                    @if (item.Role == "Admin")
                    {
                        <span style="
                            background:#dc3545;
                            color:white;
                            padding:4px 8px;
                            border-radius:4px;
                            font-size:12px;
                                ">
                            Administrator
                        </span>
                    }
                    else if (item.Role == "Editor")
                    {
                        <span style="
                            background:#17a2b8;
                            color:white;
                            padding:4px 8px;
                            border-radius:4px;
                            font-size:12px;
                                ">
                            Editor
                        </span>
                    }
                    else
                    {
                        <span style="
                            background:#6c757d;
                            color:white;
                            padding:4px 8px;
                            border-radius:4px;
                            font-size:12px;
                                ">
                            @item.Role
                        </span>
                    }

                </td>

                <!-- Thao tác -->
                <td style="padding:10px; border:1px solid #ddd;">

                    <!-- Nút sửa -->
                    <a href="#"
                       style="
                            background:#ffc107;
                            color:black;
                            padding:5px 10px;
                            text-decoration:none;
                            border-radius:4px;
                            margin-right:5px;
                            font-size:13px;
                           ">
                        Sửa
                    </a>

                    <!-- Nút xóa -->
                    <a href="#"
                       style="
                            background:#dc3545;
                            color:white;
                            padding:5px 10px;
                            text-decoration:none;
                            border-radius:4px;
                            font-size:13px;
                           ">
                        Xóa
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>