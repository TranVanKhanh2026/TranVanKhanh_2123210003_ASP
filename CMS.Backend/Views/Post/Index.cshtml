@model IEnumerable<CMS.Data.Entities.Post>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Danh sách bài viết";
}

<style>
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

        .page-header h2 {
            font-size: 15px;
            color: #4A2C17;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin: 0;
            font-weight: 500;
        }

        .page-header .sub {
            font-size: 12px;
            color: #A08060;
            margin-top: 3px;
        }

    .btn-add {
        background: #4A2C17;
        color: #F5E6C8;
        border: none;
        border-radius: 8px;
        padding: 9px 18px;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        text-decoration: none;
        transition: background .15s;
    }

        .btn-add:hover {
            background: #C8902A;
            color: #fff;
        }

    .post-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }

    .post-card {
        background: #FFFDF8;
        border-radius: 12px;
        border: 0.5px solid #D9C9B0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: border-color .15s;
    }

        .post-card:hover {
            border-color: #C8902A;
        }

        .post-card img {
            width: 100%;
            height: 160px;
            object-fit: cover;
        }

        .post-card .no-img {
            width: 100%;
            height: 160px;
            background: #EDE0CC;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            color: #C8902A;
        }

    .post-card-body {
        padding: 1rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .badge-cat {
        display: inline-block;
        background: #F5E6C8;
        color: #7A5030;
        font-size: 10px;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 3px 10px;
        border-radius: 20px;
        margin-bottom: 8px;
    }

    .post-title {
        font-size: 14px;
        font-weight: 500;
        color: #4A2C17;
        margin: 0 0 6px;
        font-family: Georgia, serif;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .post-excerpt {
        font-size: 12px;
        color: #7A5C3A;
        margin: 0 0 8px;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .post-date {
        font-size: 11px;
        color: #A08060;
        margin-bottom: 12px;
    }

    .post-actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin-top: auto;
    }

    .btn-view {
        border: 0.5px solid #4A2C17;
        background: transparent;
        color: #4A2C17;
        border-radius: 6px;
        padding: 5px 10px;
        font-size: 11px;
        text-decoration: none;
        transition: background .15s, color .15s;
    }

        .btn-view:hover {
            background: #4A2C17;
            color: #F5E6C8;
        }

    .btn-edit {
        border: 0.5px solid #C8902A;
        background: transparent;
        color: #C8902A;
        border-radius: 6px;
        padding: 5px 10px;
        font-size: 11px;
        text-decoration: none;
        transition: background .15s, color .15s;
    }

        .btn-edit:hover {
            background: #C8902A;
            color: #fff;
        }

    .btn-del {
        border: 0.5px solid #A32D2D;
        background: transparent;
        color: #A32D2D;
        border-radius: 6px;
        padding: 5px 10px;
        font-size: 11px;
        text-decoration: none;
        transition: background .15s, color .15s;
    }

        .btn-del:hover {
            background: #A32D2D;
            color: #fff;
        }

    @@media (max-width: 768px) {
        .post-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="page-header">
    <div>
        <h2><i class="bi bi-file-earmark-post me-2"></i>Danh sách bài viết</h2>
        <div class="sub">Quản lý toàn bộ bài viết trong hệ thống</div>
    </div>
    <a asp-action="Create" class="btn-add">
        <i class="bi bi-plus-circle"></i> Thêm bài viết mới
    </a>
</div>

<div class="post-grid">
    @foreach (var item in Model)
    {
        <div class="post-card">
            @if (!string.IsNullOrEmpty(item.ImageUrl))
            {
                <img src="@item.ImageUrl" alt="@item.Title" />
            }
            else
            {
                <div class="no-img">☕</div>
            }
            <div class="post-card-body">
                <span class="badge-cat">@item.Category?.Name</span>
                <p class="post-title">@item.Title</p>
                <p class="post-excerpt">@item.Content</p>
                <p class="post-date">
                    <i class="bi bi-calendar3 me-1"></i>
                    @item.CreatedDate.ToString("dd/MM/yyyy")
                </p>
                <div class="post-actions">
                    <a href="/Post/Details/@item.Id" class="btn-view">
                        <i class="bi bi-eye"></i> Xem
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-edit">
                        <i class="bi bi-pencil"></i> Sửa
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-del"
                       onclick="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?')">
                        <i class="bi bi-trash"></i> Xóa
                    </a>
                </div>
            </div>
        </div>
    }
</div>