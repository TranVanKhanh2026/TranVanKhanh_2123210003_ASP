@model IEnumerable<CMS.Data.Entities.Post>

<!-- Tiêu đề trang -->
<h2 style="color:red; margin-bottom:20px;">
    DANH SÁCH BÀI VIẾT MỚI NHẤT
</h2>

<!-- Khung chứa danh sách bài viết -->
<div style="display:flex; gap:20px; flex-wrap:wrap;">

    <!-- Duyệt từng bài viết -->
    @foreach (var item in Model)
    {
        <!-- Card bài viết -->
        <div style="
            width:250px;
            border:1px solid #ddd;
            border-radius:5px;
            padding:10px;
        ">

            <!-- Hình ảnh bài viết -->
            <img src="@item.ImageUrl"
                 alt="Thumbnail"
                 style="
                    width:100%;
                    height:150px;
                    object-fit:cover;
                 " />

            <!-- Tiêu đề bài viết -->
            <h3 style="
                color:#0d6efd;
                font-size:18px;
            ">
                @item.Title
            </h3>

            <!-- Nội dung ngắn -->
            <p>
                @(item.Content.Length > 50
                    ? item.Content.Substring(0, 50) + "..."
                    : item.Content)
            </p>

            <!-- Ngày đăng -->
            <p style="color:gray;">
                Ngày đăng:
                @item.CreatedDate.ToString("dd/MM/yyyy")
            </p>

            <!-- Nút xem chi tiết -->
            <a href="/Post/Details/@item.Id"
               style="
                    background:#0d6efd;
                    color:white;
                    padding:5px 10px;
                    text-decoration:none;
                    border-radius:4px;
               ">
                Xem chi tiết
            </a>

        </div>
    }

</div>