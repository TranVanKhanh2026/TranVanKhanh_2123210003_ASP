@model IEnumerable<CMS.Data.Entities.Order>
@{
    Layout = "_LayoutAdmin";
}
<h2 style="margin-bottom:20px;">
    QUẢN LÝ ĐƠN HÀNG
</h2>

<table style="width:100%; border-collapse:collapse;">

    <thead style="background:#6f42c1; color:white;">
        <tr>

            <th style="padding:10px; border:1px solid #ddd;">
                ID
            </th>

            <th style="padding:10px; border:1px solid #ddd;">
                Khách Hàng
            </th>

            <th style="padding:10px; border:1px solid #ddd;">
                Ngày Đặt
            </th>

            <th style="padding:10px; border:1px solid #ddd;">
                Trạng Thái
            </th>

        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td style="padding:10px; border:1px solid #ddd;">
                    @item.Id
                </td>

                <td style="padding:10px; border:1px solid #ddd;">
                    @item.CustomerId
                </td>

                <td style="padding:10px; border:1px solid #ddd;">
                    @item.OrderDate
                </td>

                <td style="padding:10px; border:1px solid #ddd;">

                    @if (item.Status == 0)
                    {
                        <span>Chờ duyệt</span>
                    }
                    else if (item.Status == 1)
                    {
                        <span>Đang giao</span>
                    }
                    else
                    {
                        <span>Đã xong</span>
                    }

                </td>

            </tr>
        }

    </tbody>

</table> 