@model IEnumerable<CMS.Data.Entities.CategoryProduct>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý danh mục sản phẩm";
}

<style>
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

        .page-header h2 {
            font-size: 15px;
            color: #4A2C17;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin: 0;
            font-weight: 500;
        }

        .page-header .sub {
            font-size: 12px;
            color: #A08060;
            margin-top: 3px;
        }

    .btn-add {
        background: #4A2C17;
        color: #F5E6C8;
        border: none;
        border-radius: 8px;
        padding: 9px 18px;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        text-decoration: none;
        transition: background .15s;
    }

        .btn-add:hover {
            background: #C8902A;
            color: #fff;
        }

    .xiao-table-wrap {
        background: #FFFDF8;
        border-radius: 12px;
        border: 0.5px solid #D9C9B0;
        overflow: hidden;
    }

    .xiao-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .xiao-table thead tr {
            background: #4A2C17;
        }

        .xiao-table thead th {
            padding: 12px 16px;
            color: #F5E6C8;
            font-weight: 500;
            letter-spacing: 0.5px;
            font-size: 12px;
            text-transform: uppercase;
            border: none;
        }

        .xiao-table tbody tr {
            border-bottom: 0.5px solid #EDE0CC;
            transition: background .15s;
        }

            .xiao-table tbody tr:last-child {
                border-bottom: none;
            }

            .xiao-table tbody tr:hover {
                background: #FAF0E0;
            }

        .xiao-table tbody td {
            padding: 12px 16px;
            color: #3A2010;
            vertical-align: middle;
        }

        .xiao-table td.id-col {
            color: #A08060;
            font-size: 12px;
            width: 60px;
        }

        .xiao-table td.name-col {
            font-weight: 500;
            color: #4A2C17;
        }

        .xiao-table td.desc-col {
            color: #7A5C3A;
        }

    .btn-edit {
        border: 0.5px solid #C8902A;
        background: transparent;
        color: #C8902A;
        border-radius: 6px;
        padding: 5px 12px;
        font-size: 12px;
        text-decoration: none;
        margin-right: 6px;
        transition: background .15s, color .15s;
        display: inline-block;
    }

        .btn-edit:hover {
            background: #C8902A;
            color: #fff;
        }

    .btn-del {
        border: 0.5px solid #A32D2D;
        background: transparent;
        color: #A32D2D;
        border-radius: 6px;
        padding: 5px 12px;
        font-size: 12px;
        text-decoration: none;
        transition: background .15s, color .15s;
        display: inline-block;
    }

        .btn-del:hover {
            background: #A32D2D;
            color: #fff;
        }
</style>

<div class="page-header">
    <div>
        <h2><i class="bi bi-grid me-2"></i>Quản lý danh mục sản phẩm</h2>
        <div class="sub">Danh sách các danh mục sản phẩm hiện có</div>
    </div>
    <a asp-controller="CategoriesProducts" asp-action="Create" class="btn-add">
        <i class="bi bi-plus-circle"></i> Thêm danh mục mới
    </a>
</div>

<div class="xiao-table-wrap">
    <table class="xiao-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tên danh mục</th>
                <th>Mô tả</th>
                <th style="width:140px; text-align:center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="id-col">#@item.Id</td>
                    <td class="name-col">@item.Name</td>
                    <td class="desc-col">@item.Description</td>
                    <td style="text-align:center">
                        <a asp-controller="CategoriesProducts" asp-action="Edit" asp-route-id="@item.Id" class="btn-edit">
                            <i class="bi bi-pencil"></i> Sửa
                        </a>
                        <a asp-controller="CategoriesProducts" asp-action="Delete" asp-route-id="@item.Id" class="btn-del"
                           onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này?')">
                            <i class="bi bi-trash"></i> Xóa
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>