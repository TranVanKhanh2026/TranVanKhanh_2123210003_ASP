<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Xiao Café Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: sans-serif;
            background: #F5EFE6;
        }

        /* ===== SIDEBAR ===== */
        .sidebar {
            width: 220px;
            min-width: 220px;
            min-height: 100vh;
            background: #2E1A0E;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            overflow-y: auto;
        }

        .sidebar-brand {
            padding: 1.5rem 1.25rem 1.25rem;
            border-bottom: 0.5px solid #4A2C17;
            text-align: center;
        }

            .sidebar-brand .logo-circle {
                width: 48px;
                height: 48px;
                background: #C8902A;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
                margin: 0 auto 10px;
            }

            .sidebar-brand .brand-name {
                color: #F5E6C8;
                font-size: 18px;
                font-family: Georgia, serif;
                font-style: italic;
                margin: 0;
            }

            .sidebar-brand .brand-sub {
                color: #A07850;
                font-size: 10px;
                letter-spacing: 2px;
                text-transform: uppercase;
                margin: 3px 0 0;
                display: block;
            }

        .sidebar-nav {
            padding: 0.75rem 0;
            flex: 1;
        }

        .nav-section {
            padding: 0.75rem 1.25rem 0.25rem;
            font-size: 9px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #7A5030;
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 1.25rem;
            color: #C8A882;
            text-decoration: none;
            font-size: 13px;
            border-left: 2px solid transparent;
            transition: background .15s, color .15s;
        }

            .sidebar-nav a:hover,
            .sidebar-nav a.active {
                background: #3D2212;
                color: #F5E6C8;
                border-left-color: #C8902A;
            }

            .sidebar-nav a i {
                font-size: 15px;
                width: 18px;
                text-align: center;
            }

        .sidebar-footer {
            padding: 1rem 1.25rem;
            border-top: 0.5px solid #4A2C17;
            font-size: 11px;
            color: #7A5030;
            text-align: center;
            letter-spacing: 0.5px;
        }

        /* ===== MAIN ===== */
        .main-wrapper {
            margin-left: 220px;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .topbar {
            background: #FFFDF8;
            border-bottom: 0.5px solid #D9C9B0;
            padding: 0 1.5rem;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }

            .topbar .page-title {
                font-size: 13px;
                color: #A08060;
                letter-spacing: 0.5px;
            }

            .topbar .user-area {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .topbar .user-greeting {
                text-align: right;
            }

                .topbar .user-greeting strong {
                    display: block;
                    font-size: 13px;
                    color: #4A2C17;
                }

                .topbar .user-greeting span {
                    font-size: 11px;
                    color: #A08060;
                    letter-spacing: 0.5px;
                }

            .topbar .avatar {
                width: 34px;
                height: 34px;
                background: #4A2C17;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #F5E6C8;
                font-size: 12px;
                font-weight: 500;
            }

            .topbar .btn-logout {
                border: 0.5px solid #D9C9B0;
                background: transparent;
                color: #7A5C3A;
                font-size: 12px;
                padding: 6px 14px;
                border-radius: 8px;
                cursor: pointer;
                letter-spacing: 0.5px;
                text-decoration: none;
                transition: background .15s, color .15s;
            }

                .topbar .btn-logout:hover {
                    background: #4A2C17;
                    color: #F5E6C8;
                    border-color: #4A2C17;
                }

        .main-content {
            padding: 1.5rem;
            flex: 1;
        }
    </style>
</head>
<body>
    <div class="d-flex">

        <nav class="sidebar">
            <div class="sidebar-brand">
                <div class="logo-circle">☕</div>
                <p class="brand-name">Xiao Café</p>
                <span class="brand-sub">Admin Panel</span>
            </div>

            <div class="sidebar-nav">
                <div class="nav-section">Tổng quan</div>
                <a asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Bảng điều khiển
                </a>

                <div class="nav-section">Nội dung</div>
                <a asp-controller="Category" asp-action="Index">
                    <i class="bi bi-grid"></i> Quản lý danh mục
                </a>
                <a asp-controller="Post" asp-action="Index">
                    <i class="bi bi-file-earmark-post"></i> Quản lý bài viết
                </a>

                <div class="nav-section">Cửa hàng</div>
                <a asp-controller="CategoriesProducts" asp-action="Index">
                    <i class="bi bi-tag"></i> Danh mục sản phẩm
                </a>
                <a asp-controller="Product" asp-action="Index">
                    <i class="bi bi-box-seam"></i> Sản phẩm
                </a>
                <a asp-controller="Customer" asp-action="Index">
                    <i class="bi bi-person-lines-fill"></i> Khách hàng
                </a>
                <a asp-controller="Order" asp-action="Index">
                    <i class="bi bi-cart3"></i> Đơn hàng
                </a>
                <a asp-controller="OrderDetail" asp-action="Index">
                    <i class="bi bi-list-check"></i> Chi tiết đơn hàng
                </a>

                <div class="nav-section">Hệ thống</div>
                <a asp-controller="User" asp-action="Index">
                    <i class="bi bi-people"></i> Quản lý thành viên
                </a>
            </div>

            <div class="sidebar-footer">Sách hay · Cà phê ngon</div>
        </nav>

     
        <div class="main-wrapper">

            <div class="topbar">
                <span class="page-title">
                    <i class="bi bi-cup-hot me-1"></i> @ViewData["Title"]
                </span>
                <div class="user-area">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="user-greeting">
                            <strong>@User.FindFirst("FullName")?.Value</strong>
                            <span>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                        </div>
                        <div class="avatar">
                            @(User.FindFirst("FullName")?.Value?.Substring(0, 1).ToUpper() ?? "A")
                        </div>
                        <a class="btn-logout"
                           asp-controller="Account"
                           asp-action="Logout">
                            <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                        </a>
                    }
                </div>
            </div>

          
            <div class="main-content">
                @RenderBody()
            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>